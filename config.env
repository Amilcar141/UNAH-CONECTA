###############################################################################
# config.env
# Proyecto: UNAH-CONECTA
# Variables compartidas por todos los scripts. No subir credenciales reales
# a un repo público — este archivo puede excluirse con .gitignore si contiene
# datos sensibles, y distribuirse solo entre el equipo.
###############################################################################

# --- Acceso por IP pública (sin dominio registrado) ---
# Formato: "<IP>" para puerto 80, o "<IP>:<puerto>" para puerto alternativo.
# Reemplaza <IP_PUBLICA> con la IP real del servidor antes de desplegar.
DOMAIN_WP="<IP_PUBLICA>"
# DOMAIN_WP_ALIAS no se usa en modo IP (sin dominio global)
DOMAIN_WP_ALIAS=""

# Moodle en puerto 8080 para no colisionar con WordPress en :80
DOMAIN_MOODLE="<IP_PUBLICA>:8080"

# --- Rutas del contenido servido (fijas según el guion del proyecto) ---
PATH_WP="/var/www/unahconecta"
PATH_MOODLE="/var/www/moodle"
DISENO_EXPORT_DIR="/opt/unah-conecta/desings"

# --- Rutas del repositorio de automatización ---
REPO_DIR="/opt/unah-conecta"
LOG_DIR="/var/log/unahconecta"
INSTALL_LOG="${LOG_DIR}/install.log"

# --- Base de datos ---
DB_WP_NAME="wordpress_db"
DB_WP_USER="wp_user"
DB_WP_PASS="WordPress1234*"          # <-- Cambiar antes del despliegue

DB_MOODLE_NAME="moodle_db"
DB_MOODLE_USER="moodle_user"
DB_MOODLE_PASS="moodle1234*"  # <-- Cambiar antes del despliegue

# --- PHP (fuente única de verdad; usada por 04-php.sh y menu.sh) ---
# Versión de PHP instalada vía ppa:ondrej/php (Ubuntu 22.04/24.04) o
# packages.sury.org (Ubuntu 26.04 "resolute", donde PHP 8.5 nativo no
# es compatible con Moodle 4.5 LTS). NO duplicar esta variable en 04-php.sh.
PHP_VERSION="8.3"

# --- WordPress (usadas por 05-wordpress.sh) ---
WP_TITLE="UNAH Conecta"
WP_ADMIN_USER="wpadmin"
WP_ADMIN_PASS="WordPress1234*"  # <-- Cambiar antes del despliegue
WP_ADMIN_EMAIL="admin@localhost"
WP_THEME_DIR="unah-conecta-theme"  # Ruta relativa al tema institucional dentro del repo

# --- Moodle (usadas por 06-moodle.sh) ---
MOODLE_DATA_DIR="/var/moodledata"
MOODLE_BRANCH="MOODLE_405_STABLE"
MOODLE_SITE_NAME="UNAH Conecta - Plataforma Virtual"
MOODLE_ADMIN_USER="moodleadmin"
MOODLE_ADMIN_PASS="Moodle1234*"  # <-- Cambiar antes del despliegue
MOODLE_ADMIN_EMAIL="admin@localhost"

# --- Apache / Virtual Hosts (usadas por 07-vhosts.sh) ---
SERVER_ADMIN_EMAIL="admin@localhost"

# --- Seguridad SSH (usadas por 08-security.sh) ---
# SSH_DISABLE_PASSWORD_AUTH=false recomendado para entorno académico.
# Cambiar a true SOLO si todo el equipo usa autenticación por llave SSH.
SSH_PORT="22"
SSH_DISABLE_PASSWORD_AUTH="false"

# --- Backup ---
BACKUP_DIR="/opt/unah-conecta/backups"
BACKUP_RETENTION_DIAS="7"

# --- Webmin (usadas por 10-webmin.sh) ---
WEBMIN_PORT="10000"

# DOMAIN_WEBMIN vacío = sin proxy reverso; Webmin accesible directo por IP:WEBMIN_PORT
DOMAIN_WEBMIN=""

# --- Monitoreo (usadas por 11-monitor.sh) ---
MONITOR_LOG_DIR="${LOG_DIR}/monitor"
MONITOR_DISK_THRESHOLD="85"

# --- Control de acceso administrativo (Webmin) ---
# Modo de resolución de IP del administrador:
#   "static"  → usa ADMIN_ALLOWED_IP directamente (IP o CIDR fijo)
#   "dynamic" → resuelve ADMIN_DDNS_HOSTNAME vía DNS y sincroniza periódicamente
ADMIN_IP_MODE="static"

# IP o CIDR fijo del administrador, usado si ADMIN_IP_MODE=static.
# Déjala vacía para no restringir acceso por IP (Webmin protegido solo por login).
# COMPLETA MANUALMENTE con tu IP real antes del despliegue si usas modo estático.
# Ejemplo (no usar literalmente): ADMIN_ALLOWED_IP="203.0.113.42"
ADMIN_ALLOWED_IP=""

# Hostname DDNS del administrador, usado si ADMIN_IP_MODE=dynamic.
# Déjala vacía si aún no tienes un servicio DDNS configurado.
# COMPLETA MANUALMENTE con tu hostname DDNS real si usas modo dinámico.
# Ejemplo (no usar literalmente): ADMIN_DDNS_HOSTNAME="mipc.duckdns.org"
ADMIN_DDNS_HOSTNAME=""

# Minutos entre resincronizaciones de IP en modo dynamic.
# También controla el intervalo del systemd timer (OnUnitActiveSec).
ADMIN_IP_SYNC_INTERVAL_MIN="5"